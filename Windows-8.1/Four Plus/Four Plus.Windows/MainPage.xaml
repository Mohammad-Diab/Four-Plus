<Page
    x:Class="Four_Plus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Four_Plus"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.BottomAppBar>
        <CommandBar>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="عن" Icon="Favorite" Click="AppBarButton_Click_2"/>
            </CommandBar.SecondaryCommands>
            <AppBarButton Label="لعبة جديدة" Icon="Add" Click="AppBarButton_Click"/>
            <AppBarButton Label="انسحاب" Icon="Emoji" Click="AppBarButton_Click_1"/>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid FlowDirection="RightToLeft" Loaded="Page_Loaded">
     
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="button" Content="ادخال" HorizontalAlignment="Right" Margin="0,0,10,10" VerticalAlignment="Bottom" Grid.Column="1" Click="button_Click" Height="77" Width="112"/>
            <TextBox x:Name="textBox" Margin="10,0,124,19" TextWrapping="Wrap" Text="" VerticalAlignment="Bottom" Height="38" Grid.ColumnSpan="2" FlowDirection="LeftToRight"/>
            <ListBox x:Name="cpu_list" Margin="5,100,10,89" Grid.Column="1" FontSize="22" FlowDirection="LeftToRight"/>
            <ListBox x:Name="user_list" Margin="10,100,5,89" FontSize="22" FlowDirection="LeftToRight"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Margin="0,5,10,0" TextWrapping="Wrap" Text="Four Plus" VerticalAlignment="Top" FontSize="36"/>
            <TextBlock x:Name="textBlock" Grid.Column="1" HorizontalAlignment="Right" Margin="0,47,12,0" TextWrapping="Wrap" Text="Mohammad Diab" VerticalAlignment="Top" FontSize="14"/>
            <TextBlock x:Name="textBlock1" HorizontalAlignment="Left" Margin="10,0,124,62" TextWrapping="Wrap" Text="أدخل رقما" VerticalAlignment="Bottom" FontSize="18" Grid.ColumnSpan="2"/>
            <Button Content="لعبة جديدة" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Click="AppBarButton_Click"/>
            <TextBlock HorizontalAlignment="Left" Margin="10,72,0,0" TextWrapping="Wrap" Text="تخميناتك" VerticalAlignment="Top" FontSize="18"/>
            <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="5,72,0,0" TextWrapping="Wrap" Text="تخمينات الكمبيوتر" VerticalAlignment="Top" FontSize="18"/>

        </Grid>
</Page>
